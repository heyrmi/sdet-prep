<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test Automation Suite" parallel="methods" thread-count="3">

    <listeners>
        <listener class-name="ra.hul.framework.listeners.TestListener"/>
        <listener class-name="ra.hul.framework.listeners.RetryTransformer"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="ra.hul.tests.ui.LoginTest"/>
            <class name="ra.hul.tests.ui.DropdownTest"/>
            <class name="ra.hul.tests.ui.CheckboxTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="ra.hul.tests.api.HttpBinApiTest"/>
        </classes>
    </test>

</suite>
